{
  "expo": {
    "name": "FishSafe",
    "slug": "fishsafe",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fishsafe-icon.png",
    "scheme": "fishsafe",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fishsafe-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F7FAF9",
        "foregroundImage": "./assets/images/fishsafe-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/fishsafe-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF9",
          "image": "./assets/images/fishsafe-splash.png",
          "imageWidth": 300
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
